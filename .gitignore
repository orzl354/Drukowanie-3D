*.gcode.3mf

# --- Kopie zapasowe i pliki tymczasowe CAD ---
*.f3d.bak
*.FCStd1
*.FCBak
# Blender: automatyczne kopie poprzedniego zapisu i pliki tymczasowe
*.blend1
*.blend2
*.blend@
*~

# --- Systemowe ---
.DS_Store
Thumbs.db
desktop.ini

# UWAGA: projekty .3mf z Bambu Studio (te BEZ ".gcode" w nazwie) są
